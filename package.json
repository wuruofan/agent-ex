{
  "name": "agent-ex-mcp",
  "version": "0.1.0",
  "description": "Schedule AI coding agents (Claude Code / OpenCode) as background tasks via MCP: detached runners, SQLite state machine, needs_input resume, Feishu notifications.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "agent-ex": "dist/server.js"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuruofan/agent-ex.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "opencode",
    "agent",
    "task-runner",
    "background-jobs"
  ],
  "scripts": {
    "build": "tsc && node scripts/gen-build-meta.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/integration.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "server": "tsx src/server.ts",
    "runner": "tsx src/runner.ts",
    "init": "tsx src/init.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
